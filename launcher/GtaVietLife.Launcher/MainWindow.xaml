<Window x:Class="GtaVietLife.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GTA Viet Life" Height="620" Width="900" MinHeight="580" MinWidth="780" WindowStartupLocation="CenterScreen" Background="#10151B" Foreground="#F2F5F7"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel><TextBlock Text="GTA VIET LIFE" FontSize="28" FontWeight="Bold" Foreground="#72D6A3"/><TextBlock Text="TRUNG TÂM KHỞI ĐỘNG" FontSize="12" Foreground="#9AA7B2"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="SINGLE PLAYER" Foreground="#9AA7B2" VerticalAlignment="Center"/></DockPanel><Border Grid.Row="1" Background="#1B252E" CornerRadius="12" Padding="18" Margin="0,0,0,18"><StackPanel><TextBlock x:Name="StatusTitle" Text="Đang kiểm tra hệ thống..." FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Text="Launcher đang kiểm tra ban đầu." Foreground="#AAB5BE" Margin="0,8,0,0" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,0" IsIndeterminate="True"/></StackPanel></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,18,0"><TextBlock Text="TRẠNG THÁI THÀNH PHẦN" Foreground="#9AA7B2" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/><Border Background="#1B252E" CornerRadius="10" Padding="16"><StackPanel><DockPanel Margin="0,6"><TextBlock Text="Launcher"/><TextBlock x:Name="LauncherState" Text="Hoạt động" DockPanel.Dock="Right" Foreground="#72D6A3"/></DockPanel><DockPanel Margin="0,9"><TextBlock Text="Engine Host"/><TextBlock x:Name="HostState" Text="Chưa khởi động" DockPanel.Dock="Right" Foreground="#E7C46A"/></DockPanel><DockPanel Margin="0,9"><TextBlock Text="Cầu nối AI"/><TextBlock x:Name="BridgeState" Text="Chưa khởi động" DockPanel.Dock="Right" Foreground="#E7C46A"/></DockPanel><DockPanel Margin="0,9"><TextBlock Text="GTA V Adapter"/><TextBlock x:Name="AdapterState" Text="Chưa kết nối" DockPanel.Dock="Right" Foreground="#E7C46A"/></DockPanel></StackPanel></Border><TextBlock Text="TỆP GTA V" Foreground="#9AA7B2" FontSize="12" FontWeight="Bold" Margin="0,20,0,8"/><DockPanel><TextBox x:Name="GamePathBox" Height="36" VerticalContentAlignment="Center" Background="#1B252E" Foreground="White" BorderBrush="#34414B" Padding="8"/><Button Content="Chọn..." Click="Browse_Click" Padding="14,6"/></DockPanel><TextBlock x:Name="RuntimeInfo" Text="Chưa kiểm tra ScriptHookVDotNet." Foreground="#9AA7B2" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="NHẬT KÝ KHỞI ĐỘNG" Foreground="#9AA7B2" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/><Border Background="#0B1015" CornerRadius="10" Padding="12" Height="300"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" Foreground="#B7C5CF" TextWrapping="Wrap"/></ScrollViewer></Border><TextBlock Text="Save game và cấu hình người chơi được lưu riêng, không bị ghi đè khi cập nhật." Foreground="#9AA7B2" FontSize="11" Margin="4,12,4,0" TextWrapping="Wrap"/></StackPanel></Grid><DockPanel Grid.Row="3" Margin="0,18,0,0"><Button x:Name="StartButton" Content="Kiểm tra &amp; khởi động" Click="Start_Click" Background="#72D6A3" Foreground="#102018" FontWeight="Bold" Padding="18,10"/><Button x:Name="PlayButton" Content="MỞ GTA V" Click="Play_Click" IsEnabled="False" Background="#27343D" Foreground="White" FontWeight="Bold"/><Button Content="Xuất nhật ký" Click="Export_Click" Background="#27343D" Foreground="White"/><Button Content="Thoát" Click="Exit_Click" Background="#27343D" Foreground="White"/></DockPanel></Grid></Window>