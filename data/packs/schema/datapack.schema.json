{
 "$comment": "Schema cho Data Pack GTA Viet Life (tập con JSON Schema: type, required, properties, enum, pattern, minimum, maxLength, items, minItems). engine/datapack.py kiểm theo file này.",
 "pack": {
  "type": "object",
  "required": ["id", "version", "schema_version", "locale", "currency", "files"],
  "properties": {
   "id": {"type": "string", "pattern": "^[A-Za-z0-9.\\-]{3,40}$"},
   "name": {"type": "string", "maxLength": 80},
   "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
   "schema_version": {"type": "integer", "enum": [1]},
   "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
   "currency": {"type": "string", "enum": ["VND", "USD"]},
   "files": {"type": "object"}
  }
 },
 "npc_names": {
  "type": "array", "minItems": 2,
  "items": {"type": "object", "required": ["id", "first_name", "last_name", "gender"],
   "properties": {"id": {"type": "string", "pattern": "^name_\\d{3}$"}, "first_name": {"type": "string", "maxLength": 30},
    "last_name": {"type": "string", "maxLength": 30}, "gender": {"type": "string", "enum": ["male", "female", "neutral"]}}}
 },
 "occupations": {
  "type": "array", "minItems": 1,
  "items": {"type": "object", "required": ["id", "name", "sector", "monthly_income_min", "monthly_income_max"],
   "properties": {"id": {"type": "string", "pattern": "^job_\\d{3}$"}, "name": {"type": "string", "maxLength": 60},
    "sector": {"type": "string", "pattern": "^[a-z_]{2,20}$"},
    "monthly_income_min": {"type": "integer", "minimum": 0}, "monthly_income_max": {"type": "integer", "minimum": 0}}}
 },
 "food_drink_menu": {
  "type": "array", "minItems": 1,
  "items": {"type": "object", "required": ["id", "name", "category", "price_min", "price_max"],
   "properties": {"id": {"type": "string", "pattern": "^food_\\d{3}$"}, "name": {"type": "string", "maxLength": 60},
    "category": {"type": "string", "enum": ["food", "drink", "snack", "dessert"]},
    "price_min": {"type": "integer", "minimum": 1}, "price_max": {"type": "integer", "minimum": 1}}}
 },
 "goods_prices": {
  "type": "array", "minItems": 1,
  "items": {"type": "object", "required": ["id", "name", "unit", "price_min", "price_max"],
   "properties": {"id": {"type": "string", "pattern": "^goods_\\d{3}$"}, "name": {"type": "string", "maxLength": 60},
    "unit": {"type": "string", "maxLength": 20}, "price_min": {"type": "integer", "minimum": 1}, "price_max": {"type": "integer", "minimum": 1}}}
 },
 "dialogue_templates": {
  "type": "array", "minItems": 1,
  "items": {"type": "object", "required": ["id", "intent", "utterance", "response"],
   "properties": {"id": {"type": "string", "pattern": "^dlg_\\d{3}$"},
    "intent": {"type": "string", "enum": ["greeting", "farewell", "small_talk", "shopping", "food_order", "workplace", "neighbor", "family",
     "transport", "repair", "emotional", "conflict", "request", "weather", "money", "relationship"]},
    "utterance": {"type": "string", "maxLength": 200}, "response": {"type": "string", "maxLength": 200}}}
 },
 "mlo_catalog_candidates": {
  "type": "array",
  "items": {"type": "object", "required": ["id", "name", "url", "author", "category", "edition", "status"],
   "properties": {"id": {"type": "string", "pattern": "^mlo_\\d{3}$"}, "name": {"type": "string", "maxLength": 80},
    "url": {"type": "string", "pattern": "^https://"}, "author": {"type": "string", "maxLength": 60},
    "category": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z_]{2,30}$"}},
    "edition": {"type": "string", "maxLength": 60}, "status": {"type": "string", "pattern": "^(candidate_[a-z_]+|verified)$"}}}
 }
}
